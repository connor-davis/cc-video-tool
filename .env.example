VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
APP_ORIGIN=http://localhost:5173

# ---
# These environment variables are required for the WorkOS SSO integration. You can find these values in your WorkOS dashboard.
# Only set these in the convex functions environment variables, not in the Vite environment variables, as they are only used in the backend.
# ---

# WORKOS_API_KEY=sk_example_123456789
# WORKOS_CLIENT_ID=client_123456789
# WORKOS_CLIENT_SECRET=client_secret_example_123456789
# Optional issuer pin. Leave unset unless your WorkOS tokens use a stable issuer you want to enforce.
# WORKOS_ISSUER=https://api.workos.com/
# Optional override if your WorkOS environment exposes a different JWKS URL.
# WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_123456789
